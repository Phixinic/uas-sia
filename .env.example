# Salin ke .env lalu sesuaikan. Ini kredensial pengembangan lokal, bukan rahasia produksi.
# Postgres lokal lewat Docker (lihat README): port 5433 supaya tidak bentrok dengan Postgres lain.
DATABASE_URL="postgresql://sia:sia@localhost:5433/sia_dpro?schema=public"

# Kata sandi akun demo yang dibuat oleh `npm run db:seed`:
#   admin / admin123   (Admin)
#   hrd   / hrd12345   (HRD)
#   owner / owner123   (Owner)
# Untuk server sungguhan, ganti kata sandinya lewat menu Pengguna setelah seed.
