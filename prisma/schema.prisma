// SIA D'Production: skema relasional untuk siklus konversi, siklus SDM, dan pelaporan.
// Konvensi: nama model PascalCase, kolom camelCase di kode, tabel dan kolom snake_case di database
// (lewat @@map/@map) supaya sama dengan logical database di versi-statis/docs/logical-database.puml.
// Nilai rupiah disimpan sebagai Int (rupiah bulat, batas Rp2.147.483.647 per nilai).
// Kode master dan nomor dokumen dipakai sebagai kunci utama (contoh SUP-01, BP-2026-0001, AST-0001).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================================
// Enum
// ======================================================================

enum Peran {
  ADMIN
  HRD
  OWNER
  /// Kapten event (crew freelance yang ditunjuk memimpin event). Ditautkan ke satu karyawan EVENT.
  KAPTEN
}

/// Status persetujuan bersama: jurnal, pelepasan, opname, slip gaji, penggajian.
enum StatusPersetujuan {
  DRAFT
  DIAJUKAN
  DISETUJUI
  DITOLAK
}

/// Pembelian memakai status persetujuan ditambah DIBALIK (sesudah dibuat jurnal pembalik).
/// DISETUJUI = sudah diposting.
enum StatusPembelian {
  DRAFT
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DIBALIK
}

enum TipeAkun {
  ASET
  KONTRA_ASET
  LIABILITAS
  EKUITAS
  PENDAPATAN
  BEBAN
}

enum SaldoNormal {
  D
  K
}

enum JenisJurnal {
  UMUM
  PENYESUAIAN
  PEMBALIK
}

enum SumberJurnal {
  SALDO_AWAL
  PEMBELIAN
  PENYUSUTAN
  OPNAME
  PELEPASAN
  PENGGAJIAN
  FEE_EVENT
  /// Setoran modal pemilik berupa kas (tabel investasi_kas). Jurnal setoran lama bersumber SALDO_AWAL dipindah ke sini oleh migrasi.
  INVESTASI_KAS
}

/// Jenis perubahan setting gaji (riwayat). SETTING_AWAL hanya untuk karyawan yang belum punya versi disetujui.
enum JenisPerubahanGaji {
  SETTING_AWAL
  PROMOSI
  DEMOSI
  PENYESUAIAN
}

/// Jenis item master yang nominalnya berversi (tabel versi_nominal). JABATAN = tunjangan jabatan dan tunjangan istri/anak
/// jabatan inhouse, JABATAN_EVENT = tarif jabatan event.
enum JenisNominal {
  GOLONGAN
  TUNJANGAN
  JABATAN
  JABATAN_EVENT
}

enum StatusPeriode {
  TERBUKA
  TERKUNCI
}

enum AksiPeriode {
  KUNCI
  BUKA
}

enum JenisPembelian {
  PERALATAN
  PERLENGKAPAN
}

enum CaraBayar {
  TUNAI
  KREDIT
  INVESTASI
}

enum DasarN {
  GARANSI
  MASA_MANFAAT
}

enum StatusAset {
  AKTIF
  DILEPAS
  BATAL
}

enum AlasanPelepasan {
  DIJUAL
  DIBUANG
  HILANG
}

enum StatusPtkp {
  TK0 @map("TK/0")
  TK1 @map("TK/1")
  TK2 @map("TK/2")
  TK3 @map("TK/3")
  K0  @map("K/0")
  K1  @map("K/1")
  K2  @map("K/2")
  K3  @map("K/3")
}

/// INHOUSE = gaji tetap bulanan (presensi, setting gaji, slip gaji). EVENT = crew freelance dibayar fee per event.
enum JenisKaryawan {
  INHOUSE
  EVENT
}

/// Kelompok jabatan: INHOUSE untuk setting gaji bulanan, EVENT untuk penugasan event (Kapten, Crew).
enum KelompokJabatan {
  INHOUSE
  EVENT
}

/// Peran dalam event. KAPTEN menilai progres crew; CREW dinilai kapten.
enum PeranEvent {
  KAPTEN
  CREW
}

/// Satuan tarif jabatan event: per hari (jumlah tanggal berbeda yang dihadiri) atau per jam (jam yang diakui).
enum SatuanTarif {
  HARI
  JAM
}

/// PENILAIAN = HRD mencatat kehadiran dan kapten menilai; DIAJUKAN = laporan kapten menunggu Owner; SELESAI = fee dibayar.
enum StatusEvent {
  PENILAIAN
  DIAJUKAN
  SELESAI
}

enum HasilPenilaian {
  SESUAI
  KURANG
}

enum Absensi {
  HADIR
  IZIN
  SAKIT
  CUTI
  ALPA
}

// ======================================================================
// Pengguna, sesi, log
// ======================================================================

model Pengguna {
  id            Int      @id @default(autoincrement())
  namaPengguna  String   @unique @map("nama_pengguna")
  nama          String
  kataSandiHash String   @map("kata_sandi_hash")
  peran         Peran
  aktif         Boolean  @default(true)
  dibuatPada    DateTime @default(now()) @map("dibuat_pada")
  /// Hanya untuk peran KAPTEN: karyawan EVENT yang dipegang akun ini (1:0..1).
  karyawanKode  String?  @unique @map("id_karyawan")

  karyawan Karyawan?      @relation(fields: [karyawanKode], references: [kode])
  sesi     Sesi[]
  log      LogAktivitas[]

  jurnalDibuat        Jurnal[]         @relation("JurnalDibuat")
  jurnalDisetujui     Jurnal[]         @relation("JurnalDisetujui")
  pembelianDibuat     Pembelian[]      @relation("PembelianDibuat")
  pembelianDisetujui  Pembelian[]      @relation("PembelianDisetujui")
  pembelianDibalik    Pembelian[]      @relation("PembelianDibalik")
  pelepasanDibuat     Pelepasan[]      @relation("PelepasanDibuat")
  pelepasanDisetujui  Pelepasan[]      @relation("PelepasanDisetujui")
  opnameDibuat        Opname[]         @relation("OpnameDibuat")
  opnameDisetujui     Opname[]         @relation("OpnameDisetujui")
  revisiDiajukan      RevisiOpname[]   @relation("RevisiDiajukan")
  revisiDiputuskan    RevisiOpname[]   @relation("RevisiDiputuskan")
  slipDibuat          SlipGaji[]       @relation("SlipDibuat")
  slipDisetujui       SlipGaji[]       @relation("SlipDisetujui")
  penggajianDibuat    Penggajian[]     @relation("PenggajianDibuat")
  penggajianDisetujui Penggajian[]     @relation("PenggajianDisetujui")
  presensiDibuat      Presensi[]
  periodeDikunci      Periode[]
  riwayatPeriode      RiwayatPeriode[]
  eventDibuat         Event[]          @relation("EventDibuat")
  kehadiranDibuat     KehadiranEvent[] @relation("KehadiranDibuat")
  kehadiranDinilai    KehadiranEvent[] @relation("KehadiranDinilai")
  laporanDiajukan     LaporanFee[]     @relation("LaporanDiajukan")
  laporanDiputuskan   LaporanFee[]     @relation("LaporanDiputuskan")
  investasiDibuat     InvestasiKas[]   @relation("InvestasiDibuat")
  investasiDiputuskan InvestasiKas[]   @relation("InvestasiDiputuskan")
  settingDiajukan     SettingGaji[]    @relation("SettingDiajukan")
  settingDiputuskan   SettingGaji[]    @relation("SettingDiputuskan")
  nominalDiajukan     VersiNominal[]   @relation("NominalDiajukan")
  nominalDiputuskan   VersiNominal[]   @relation("NominalDiputuskan")

  @@map("pengguna")
}

model Sesi {
  id          Int      @id @default(autoincrement())
  /// SHA-256 dari token acak di cookie; token aslinya tidak pernah disimpan.
  tokenHash   String   @unique @map("token_hash")
  penggunaId  Int      @map("pengguna_id")
  kedaluwarsa DateTime
  dibuatPada  DateTime @default(now()) @map("dibuat_pada")

  pengguna Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)

  @@index([penggunaId])
  @@map("sesi")
}

model LogAktivitas {
  id         Int      @id @default(autoincrement())
  waktu      DateTime @default(now())
  penggunaId Int?     @map("pengguna_id")
  /// Kata kerja singkat, contoh "pembelian.posting", "jurnal.setujui".
  aksi       String
  entitas    String
  entitasId  String?  @map("entitas_id")
  keterangan String?

  pengguna Pengguna? @relation(fields: [penggunaId], references: [id], onDelete: SetNull)

  @@index([waktu])
  @@index([entitas, entitasId])
  @@map("log_aktivitas")
}

/// Satu baris saja (id = 1): nama usaha yang tampil di sidebar.
model ProfilUsaha {
  id         Int    @id @default(1)
  nama       String
  keterangan String @default("")

  @@map("profil_usaha")
}

/// Penghitung nomor dokumen. Kunci contoh: "JU2026", "BP2026", "AST", "SUP".
model Penghitung {
  kunci String @id
  nilai Int    @default(0)

  @@map("penghitung")
}

// ======================================================================
// Pelaporan: akun, periode, jurnal
// ======================================================================

model Akun {
  kode        String      @id @map("kode_akun")
  nama        String
  tipe        TipeAkun
  saldoNormal SaldoNormal @map("saldo_normal")
  aktif       Boolean     @default(true)

  detailJurnal      DetailJurnal[]
  kategoriAset      KategoriAset[] @relation("KategoriAkunAset")
  kategoriAkumulasi KategoriAset[] @relation("KategoriAkunAkumulasi")
  kategoriBeban     KategoriAset[] @relation("KategoriAkunBeban")
  asetAkunAset      Aset[]         @relation("AsetAkunAset")
  asetAkunAkumulasi Aset[]         @relation("AsetAkunAkumulasi")
  asetAkunBeban     Aset[]         @relation("AsetAkunBeban")
  jabatan           Jabatan[]
  slipGaji          SlipGaji[]
  slipFee           SlipFee[]

  @@map("akun")
}

/// Periode akuntansi bulanan, id berbentuk "YYYY-MM".
model Periode {
  id          String        @id @map("periode")
  /// Bulan (1-12) dan tahun dari id "YYYY-MM". Kolom generated di PostgreSQL (GENERATED ALWAYS AS ... STORED),
  /// jadi selalu terisi dan tidak pernah ditulis aplikasi. Lihat migrasi 20261123120000_setting_gaji_riwayat.
  bulan       Int           @default(dbgenerated()) @db.SmallInt
  tahun       Int           @default(dbgenerated()) @db.SmallInt
  status      StatusPeriode @default(TERBUKA)
  dikunciOleh Int?          @map("dikunci_oleh")
  dikunciPada DateTime?     @map("dikunci_pada")

  pengunci     Pengguna?          @relation(fields: [dikunciOleh], references: [id])
  riwayat      RiwayatPeriode[]
  jurnal       Jurnal[]
  jadwal       JadwalPenyusutan[]
  opname       Opname?
  slipGaji     SlipGaji[]
  penggajian   Penggajian[]
  /// Versi setting gaji yang mulai berlaku di periode ini.
  settingGaji  SettingGaji[]
  /// Versi nominal master yang mulai berlaku di periode ini.
  versiNominal VersiNominal[]
  upahEvent    SlipFee[]

  @@index([tahun, bulan])
  @@map("periode")
}

model RiwayatPeriode {
  id        Int         @id @default(autoincrement())
  periodeId String      @map("periode")
  aksi      AksiPeriode
  olehId    Int         @map("oleh")
  waktu     DateTime    @default(now())
  alasan    String?

  periode Periode  @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  oleh    Pengguna @relation(fields: [olehId], references: [id])

  @@index([periodeId])
  @@map("riwayat_periode")
}

model Jurnal {
  no              String            @id @map("no_jurnal")
  tanggal         DateTime          @db.Date
  periodeId       String            @map("periode")
  jenis           JenisJurnal
  keterangan      String
  status          StatusPersetujuan @default(DRAFT)
  alasanTolak     String?           @map("alasan_tolak")
  sumberTipe      SumberJurnal?     @map("sumber_tipe")
  /// Nomor dokumen sumber (no pembelian, periode penyusutan, no opname, no pelepasan, no penggajian).
  sumberId        String?           @map("sumber_id")
  /// Jurnal pembalik menunjuk jurnal asli yang dibaliknya (1:0..1).
  pembalikDariNo  String?           @unique @map("pembalik_dari")
  dibuatOlehId    Int               @map("dibuat_oleh")
  dibuatPada      DateTime          @default(now()) @map("dibuat_pada")
  diajukanPada    DateTime?         @map("diajukan_pada")
  disetujuiOlehId Int?              @map("disetujui_oleh")
  disetujuiPada   DateTime?         @map("disetujui_pada")

  periode       Periode        @relation(fields: [periodeId], references: [id])
  pembalikDari  Jurnal?        @relation("Pembalik", fields: [pembalikDariNo], references: [no])
  dibalikOleh   Jurnal?        @relation("Pembalik")
  dibuatOleh    Pengguna       @relation("JurnalDibuat", fields: [dibuatOlehId], references: [id])
  disetujuiOleh Pengguna?      @relation("JurnalDisetujui", fields: [disetujuiOlehId], references: [id])
  detail        DetailJurnal[]

  pembelian         Pembelian?         @relation("PembelianJurnal")
  pembelianPembalik Pembelian?         @relation("PembelianJurnalPembalik")
  jadwalPenyusutan  JadwalPenyusutan[]
  opname            Opname?
  pelepasan         Pelepasan?
  penggajian        Penggajian?
  laporanFee        LaporanFee?
  investasiKas      InvestasiKas?
  revisiPembalik    RevisiOpname?      @relation("RevisiJurnalPembalik")
  revisiBaru        RevisiOpname?      @relation("RevisiJurnalBaru")

  @@index([periodeId, status])
  @@index([jenis, status])
  @@index([sumberTipe, sumberId])
  @@map("jurnal")
}

model DetailJurnal {
  jurnalNo String @map("no_jurnal")
  noUrut   Int    @map("no_urut")
  akunKode String @map("kode_akun")
  debit    Int    @default(0)
  kredit   Int    @default(0)

  jurnal Jurnal @relation(fields: [jurnalNo], references: [no], onDelete: Cascade)
  akun   Akun   @relation(fields: [akunKode], references: [kode])

  @@id([jurnalNo, noUrut])
  @@index([akunKode])
  @@map("detail_jurnal")
}

/// Investasi Kas: setoran modal pemilik berupa uang ke kas. Aplikasi hanya mencakup siklus konversi dan SDM
/// (tanpa siklus pendapatan), jadi kas untuk pembelian tunai, gaji, dan fee berasal dari setoran ini.
/// Dibuat DIAJUKAN (Admin atau Owner) -> Owner DISETUJUI (jurnal umum Dr Kas, Kr Modal Pemilik) / DITOLAK.
/// CHECK di migrasi: jumlah > 0, status bukan DRAFT, DISETUJUI wajib punya jurnal, DITOLAK wajib punya alasan.
model InvestasiKas {
  no               String            @id @map("no_investasi")
  tanggal          DateTime          @db.Date
  jumlah           Int
  /// Keterangan atau sumber dana, contoh "Setoran pemilik dari rekening pribadi".
  keterangan       String
  status           StatusPersetujuan @default(DIAJUKAN)
  alasanTolak      String?           @map("alasan_tolak")
  jurnalNo         String?           @unique @map("jurnal_no")
  dibuatOlehId     Int               @map("dibuat_oleh")
  dibuatPada       DateTime          @default(now()) @map("dibuat_pada")
  diputuskanOlehId Int?              @map("diputuskan_oleh")
  diputuskanPada   DateTime?         @map("diputuskan_pada")

  jurnal         Jurnal?   @relation(fields: [jurnalNo], references: [no], onDelete: Restrict)
  dibuatOleh     Pengguna  @relation("InvestasiDibuat", fields: [dibuatOlehId], references: [id])
  diputuskanOleh Pengguna? @relation("InvestasiDiputuskan", fields: [diputuskanOlehId], references: [id])

  @@index([status])
  @@index([tanggal])
  @@map("investasi_kas")
}

// ======================================================================
// Siklus konversi
// ======================================================================

model Supplier {
  kode    String  @id @map("id_supplier")
  nama    String
  alamat  String  @default("")
  telepon String  @default("")
  email   String  @default("")
  npwp    String? @unique
  aktif   Boolean @default(true)

  pembelian Pembelian[]

  @@map("supplier")
}

model KategoriAset {
  kode              String  @id @map("id_kategori")
  nama              String
  masaManfaatBulan  Int     @map("masa_manfaat_bulan")
  persenResidu      Int     @default(0) @map("persen_residu")
  akunAsetKode      String  @map("akun_aset")
  akunAkumulasiKode String  @map("akun_akumulasi")
  akunBebanKode     String  @map("akun_beban")
  aktif             Boolean @default(true)

  akunAset      Akun        @relation("KategoriAkunAset", fields: [akunAsetKode], references: [kode])
  akunAkumulasi Akun        @relation("KategoriAkunAkumulasi", fields: [akunAkumulasiKode], references: [kode])
  akunBeban     Akun        @relation("KategoriAkunBeban", fields: [akunBebanKode], references: [kode])
  peralatan     Peralatan[]
  aset          Aset[]

  @@map("kategori_aset")
}

model Peralatan {
  kode         String  @id @map("id_peralatan")
  nama         String
  satuan       String
  kategoriKode String  @map("id_kategori")
  aktif        Boolean @default(true)

  kategori KategoriAset      @relation(fields: [kategoriKode], references: [kode])
  detail   DetailPembelian[]
  aset     Aset[]

  @@map("peralatan")
}

model Perlengkapan {
  kode   String  @id @map("id_perlengkapan")
  nama   String
  satuan String
  aktif  Boolean @default(true)

  detail       DetailPembelian[]
  detailOpname DetailOpname[]
  detailRevisi DetailRevisiOpname[]

  @@map("perlengkapan")
}

model Pembelian {
  no               String          @id @map("no_pembelian")
  jenis            JenisPembelian
  tanggal          DateTime        @db.Date
  /// Kosong untuk cara bayar INVESTASI (barang disetor pemilik).
  supplierKode     String?         @map("id_supplier")
  caraBayar        CaraBayar       @map("cara_bayar")
  jatuhTempo       DateTime?       @map("jatuh_tempo") @db.Date
  keterangan       String          @default("")
  total            Int
  status           StatusPembelian @default(DRAFT)
  alasanTolak      String?         @map("alasan_tolak")
  jurnalNo         String?         @unique @map("jurnal_no")
  jurnalPembalikNo String?         @unique @map("jurnal_pembalik")
  alasanBalik      String?         @map("alasan_balik")
  dibuatOlehId     Int             @map("dibuat_oleh")
  dibuatPada       DateTime        @default(now()) @map("dibuat_pada")
  diubahPada       DateTime        @updatedAt @map("diubah_pada")
  /// Yang memposting (Admin atau Owner). Posting = status DISETUJUI.
  disetujuiOlehId  Int?            @map("disetujui_oleh")
  disetujuiPada    DateTime?       @map("disetujui_pada")
  dibalikOlehId    Int?            @map("dibalik_oleh")
  dibalikPada      DateTime?       @map("dibalik_pada")

  supplier       Supplier?         @relation(fields: [supplierKode], references: [kode])
  jurnal         Jurnal?           @relation("PembelianJurnal", fields: [jurnalNo], references: [no])
  jurnalPembalik Jurnal?           @relation("PembelianJurnalPembalik", fields: [jurnalPembalikNo], references: [no])
  dibuatOleh     Pengguna          @relation("PembelianDibuat", fields: [dibuatOlehId], references: [id])
  disetujuiOleh  Pengguna?         @relation("PembelianDisetujui", fields: [disetujuiOlehId], references: [id])
  dibalikOleh    Pengguna?         @relation("PembelianDibalik", fields: [dibalikOlehId], references: [id])
  detail         DetailPembelian[]

  @@index([jenis, status])
  @@index([tanggal])
  @@map("pembelian")
}

/// Satu baris barang. Tepat satu dari peralatanKode/perlengkapanKode terisi (CHECK di migrasi).
/// Kolom penyusutan (residu, garansi, masa manfaat, dasar n) hanya untuk peralatan.
model DetailPembelian {
  pembelianNo      String  @map("no_pembelian")
  noUrut           Int     @map("no_urut")
  peralatanKode    String? @map("id_peralatan")
  perlengkapanKode String? @map("id_perlengkapan")
  qty              Int
  harga            Int
  residu           Int?
  garansiBulan     Int?    @map("garansi_bulan")
  masaManfaatBulan Int?    @map("masa_manfaat_bulan")
  dasarN           DasarN? @map("dasar_n")

  pembelian    Pembelian     @relation(fields: [pembelianNo], references: [no], onDelete: Cascade)
  peralatan    Peralatan?    @relation(fields: [peralatanKode], references: [kode])
  perlengkapan Perlengkapan? @relation(fields: [perlengkapanKode], references: [kode])
  aset         Aset[]

  @@id([pembelianNo, noUrut])
  @@map("detail_pembelian")
}

/// Kartu aset: satu baris per unit peralatan yang dibeli.
model Aset {
  kode              String     @id @map("id_aset")
  pembelianNo       String     @map("no_pembelian")
  noUrut            Int        @map("no_urut")
  peralatanKode     String     @map("id_peralatan")
  kategoriKode      String     @map("id_kategori")
  /// Salinan nama peralatan saat diperoleh.
  nama              String
  tglPerolehan      DateTime   @map("tgl_perolehan") @db.Date
  /// Periode penyusutan pertama ("YYYY-MM").
  bulanMulai        String     @map("bulan_mulai")
  nilaiPerolehan    Int        @map("nilai_perolehan")
  residu            Int
  garansiBulan      Int        @map("garansi_bulan")
  garansiSampai     DateTime?  @map("garansi_sampai") @db.Date
  masaManfaatBulan  Int        @map("masa_manfaat_bulan")
  dasarN            DasarN     @map("dasar_n")
  /// Jumlah periode penyusutan.
  n                 Int
  /// Beban periode 1 s.d. n-1 (rumus 1).
  d                 Int
  /// Beban periode n (rumus 2).
  terakhir          Int
  /// true bila rumus 1 dibulatkan ke bawah supaya beban terakhir tidak negatif.
  pengaman          Boolean    @default(false)
  akunAsetKode      String     @map("akun_aset")
  akunAkumulasiKode String     @map("akun_akumulasi")
  akunBebanKode     String     @map("akun_beban")
  status            StatusAset @default(AKTIF)
  tanggalLepas      DateTime?  @map("tanggal_lepas") @db.Date

  detailPembelian DetailPembelian    @relation(fields: [pembelianNo, noUrut], references: [pembelianNo, noUrut])
  peralatan       Peralatan          @relation(fields: [peralatanKode], references: [kode])
  kategori        KategoriAset       @relation(fields: [kategoriKode], references: [kode])
  akunAset        Akun               @relation("AsetAkunAset", fields: [akunAsetKode], references: [kode])
  akunAkumulasi   Akun               @relation("AsetAkunAkumulasi", fields: [akunAkumulasiKode], references: [kode])
  akunBeban       Akun               @relation("AsetAkunBeban", fields: [akunBebanKode], references: [kode])
  /// 1:0..N. Kosong bila aset batal; tinggal baris yang sudah dijurnal bila aset dilepas.
  jadwal          JadwalPenyusutan[]
  pelepasan       Pelepasan[]

  @@index([status])
  @@index([pembelianNo])
  @@map("aset")
}

model JadwalPenyusutan {
  asetKode  String  @map("id_aset")
  periodeKe Int     @map("periode_ke")
  periodeId String  @map("periode")
  beban     Int
  akumulasi Int
  nilaiBuku Int     @map("nilai_buku")
  /// Terisi saat beban periode ini sudah dibuatkan jurnal penyesuaian.
  jurnalNo  String? @map("jurnal_no")

  aset    Aset    @relation(fields: [asetKode], references: [kode], onDelete: Cascade)
  periode Periode @relation(fields: [periodeId], references: [id])
  jurnal  Jurnal? @relation(fields: [jurnalNo], references: [no])

  @@id([asetKode, periodeKe])
  @@index([periodeId])
  @@index([jurnalNo])
  @@map("jadwal_penyusutan")
}

/// Input nilai sisa (hitung fisik) perlengkapan, paling banyak satu per periode.
model Opname {
  no              String            @id @map("id_opname")
  periodeId       String            @unique @map("periode")
  totalBeban      Int               @map("total_beban")
  status          StatusPersetujuan @default(DRAFT)
  alasanTolak     String?           @map("alasan_tolak")
  jurnalNo        String?           @unique @map("jurnal_no")
  dibuatOlehId    Int               @map("dibuat_oleh")
  dibuatPada      DateTime          @default(now()) @map("dibuat_pada")
  disetujuiOlehId Int?              @map("disetujui_oleh")
  disetujuiPada   DateTime?         @map("disetujui_pada")

  periode       Periode        @relation(fields: [periodeId], references: [id])
  jurnal        Jurnal?        @relation(fields: [jurnalNo], references: [no])
  dibuatOleh    Pengguna       @relation("OpnameDibuat", fields: [dibuatOlehId], references: [id])
  disetujuiOleh Pengguna?      @relation("OpnameDisetujui", fields: [disetujuiOlehId], references: [id])
  detail        DetailOpname[]
  revisi        RevisiOpname[]

  @@map("opname")
}

model DetailOpname {
  opnameNo         String @map("id_opname")
  perlengkapanKode String @map("id_perlengkapan")
  saldoBuku        Int    @map("saldo_buku")
  nilaiSisa        Int    @map("nilai_sisa")

  opname       Opname       @relation(fields: [opnameNo], references: [no], onDelete: Cascade)
  perlengkapan Perlengkapan @relation(fields: [perlengkapanKode], references: [kode])

  @@id([opnameNo, perlengkapanKode])
  @@map("detail_opname")
}

/// Revisi nilai sisa sesudah opname disetujui (selama periode belum ditutup). Satu baris = satu pengajuan revisi.
/// Dikembalikan Owner = DITOLAK dengan alasan; Admin mengajukan revisi baru (baris baru), jadi alasannya tetap di riwayat.
/// Disetujui: jurnal opname yang berlaku dibalik (jurnal_pembalik) dan jurnal baru dibuat (jurnal_baru, kosong bila biaya 0).
model RevisiOpname {
  no               String            @id @map("no_revisi")
  opnameNo         String            @map("id_opname")
  ke               Int
  totalBebanLama   Int               @map("total_beban_lama")
  totalBeban       Int               @map("total_beban")
  alasan           String
  status           StatusPersetujuan @default(DIAJUKAN)
  alasanTolak      String?           @map("alasan_tolak")
  jurnalLamaNo     String?           @map("jurnal_lama")
  jurnalPembalikNo String?           @unique @map("jurnal_pembalik")
  jurnalBaruNo     String?           @unique @map("jurnal_baru")
  diajukanOlehId   Int               @map("diajukan_oleh")
  diajukanPada     DateTime          @default(now()) @map("diajukan_pada")
  diputuskanOlehId Int?              @map("diputuskan_oleh")
  diputuskanPada   DateTime?         @map("diputuskan_pada")

  opname         Opname               @relation(fields: [opnameNo], references: [no])
  jurnalPembalik Jurnal?              @relation("RevisiJurnalPembalik", fields: [jurnalPembalikNo], references: [no])
  jurnalBaru     Jurnal?              @relation("RevisiJurnalBaru", fields: [jurnalBaruNo], references: [no])
  diajukanOleh   Pengguna             @relation("RevisiDiajukan", fields: [diajukanOlehId], references: [id])
  diputuskanOleh Pengguna?            @relation("RevisiDiputuskan", fields: [diputuskanOlehId], references: [id])
  detail         DetailRevisiOpname[]

  @@unique([opnameNo, ke])
  @@index([status])
  @@map("revisi_opname")
}

/// Nilai sisa usulan per perlengkapan dalam satu revisi (saldo buku sama dengan opname yang direvisi).
model DetailRevisiOpname {
  revisiNo         String @map("no_revisi")
  perlengkapanKode String @map("id_perlengkapan")
  saldoBuku        Int    @map("saldo_buku")
  nilaiSisaLama    Int    @map("nilai_sisa_lama")
  nilaiSisa        Int    @map("nilai_sisa")

  revisi       RevisiOpname @relation(fields: [revisiNo], references: [no], onDelete: Cascade)
  perlengkapan Perlengkapan @relation(fields: [perlengkapanKode], references: [kode])

  @@id([revisiNo, perlengkapanKode])
  @@map("detail_revisi_opname")
}

model Pelepasan {
  no              String            @id @map("no_pelepasan")
  asetKode        String            @map("id_aset")
  tanggal         DateTime          @db.Date
  alasan          AlasanPelepasan
  hargaJual       Int               @default(0) @map("harga_jual")
  nilaiPerolehan  Int               @map("nilai_perolehan")
  akumulasi       Int
  nilaiBuku       Int               @map("nilai_buku")
  /// Positif = laba, negatif = rugi.
  labaRugi        Int               @map("laba_rugi")
  status          StatusPersetujuan @default(DIAJUKAN)
  alasanTolak     String?           @map("alasan_tolak")
  jurnalNo        String?           @unique @map("jurnal_no")
  dibuatOlehId    Int               @map("dibuat_oleh")
  dibuatPada      DateTime          @default(now()) @map("dibuat_pada")
  disetujuiOlehId Int?              @map("disetujui_oleh")
  disetujuiPada   DateTime?         @map("disetujui_pada")

  aset          Aset      @relation(fields: [asetKode], references: [kode])
  jurnal        Jurnal?   @relation(fields: [jurnalNo], references: [no])
  dibuatOleh    Pengguna  @relation("PelepasanDibuat", fields: [dibuatOlehId], references: [id])
  disetujuiOleh Pengguna? @relation("PelepasanDisetujui", fields: [disetujuiOlehId], references: [id])

  @@index([asetKode, status])
  @@map("pelepasan")
}

// ======================================================================
// Siklus SDM
// ======================================================================

model Karyawan {
  kode       String        @id @map("id_karyawan")
  nama       String
  statusPtkp StatusPtkp    @map("status_ptkp")
  bank       String
  noRek      String        @map("no_rek")
  /// Data lama otomatis INHOUSE. Karyawan EVENT tidak punya setting gaji.
  jenis      JenisKaryawan @default(INHOUSE)
  aktif      Boolean       @default(true)

  /// Riwayat setting gaji (semua versi). Versi berlaku per periode dipilih oleh pilihVersiBerlaku.
  settingGaji SettingGaji[]
  presensi    Presensi[]
  slipGaji    SlipGaji[]
  pengguna    Pengguna?
  penugasan   PenugasanEvent[]
  kehadiran   KehadiranEvent[]
  slipFee     SlipFee[]

  @@map("karyawan")
}

/// Nominal jabatan (tunjangan jabatan dan tunjangan istri/anak untuk inhouse, tarif untuk event) tidak disimpan di sini,
/// tetapi di versi_nominal (riwayat dengan bulan berlaku dan persetujuan Owner).
model Jabatan {
  kode          String          @id @map("id_jabatan")
  nama          String
  akunBebanKode String          @map("akun_beban")
  /// Data lama otomatis INHOUSE. Jabatan EVENT dipakai di penugasan event dan hanya diubah Owner.
  kelompok      KelompokJabatan @default(INHOUSE)
  /// Hanya jabatan EVENT: peran dalam event dan satuan tarif (per hari atau per jam). Tarifnya di versi_nominal.
  peranEvent    PeranEvent?     @map("peran_event")
  satuanTarif   SatuanTarif?    @map("satuan_tarif")
  /// Jadwal kerja jabatan inhouse (dulu tabel jadwal_kerja, relasi 1:1): jam masuk, jam keluar, hari kerja per bulan.
  /// Kosong untuk jabatan event dan jabatan inhouse yang belum punya jadwal.
  jamMasuk      String?         @map("jam_masuk")
  jamKeluar     String?         @map("jam_keluar")
  hariKerja     Int?            @map("hari_kerja")
  aktif         Boolean         @default(true)

  akunBeban    Akun             @relation(fields: [akunBebanKode], references: [kode])
  presensi     Presensi[]
  settingGaji  SettingGaji[]
  slipGaji     SlipGaji[]
  penugasan    PenugasanEvent[]
  slipFee      SlipFee[]
  versiNominal VersiNominal[]

  @@map("jabatan")
}

/// Golongan gaji pokok. Gaji pokoknya di versi_nominal (riwayat dengan bulan berlaku dan persetujuan Owner).
model Golongan {
  kode  String  @id @map("id_golongan")
  nama  String
  aktif Boolean @default(true)

  settingGaji  SettingGaji[]
  slipGaji     SlipGaji[]
  versiNominal VersiNominal[]

  @@map("golongan")
}

/// Tunjangan lain. Nominal per bulannya di versi_nominal (riwayat dengan bulan berlaku dan persetujuan Owner).
model Tunjangan {
  kode  String  @id @map("id_tunjangan")
  nama  String
  aktif Boolean @default(true)

  setting      SettingTunjangan[]
  slip         SlipTunjangan[]
  versiNominal VersiNominal[]

  @@map("tunjangan")
}

/// Satu versi setting gaji karyawan inhouse (riwayat, tidak pernah ditimpa). Setiap versi lewat pengajuan HRD atau Owner
/// dan persetujuan Owner. Versi berlaku di periode P = versi DISETUJUI dengan berlaku_mulai <= P yang paling akhir
/// (berlaku_mulai terbesar, lalu diputuskan_pada terakhir). Slip tetap menyalin nilai saat dihitung dan menyimpan id versinya.
model SettingGaji {
  kode             String             @id @map("id_setting")
  karyawanKode     String             @map("id_karyawan")
  jabatanKode      String             @map("id_jabatan")
  golonganKode     String             @map("id_golongan")
  /// Kolom lama. Versi yang dinonaktifkan sebelum riwayat ada dianggap tidak berlaku; versi baru selalu aktif.
  aktif            Boolean            @default(true)
  /// Periode "YYYY-MM" mulai berlakunya versi ini.
  berlakuMulai     String             @map("berlaku_mulai")
  jenisPerubahan   JenisPerubahanGaji @default(SETTING_AWAL) @map("jenis_perubahan")
  alasan           String             @default("")
  /// DIAJUKAN, DISETUJUI, atau DITOLAK (DRAFT tidak dipakai, dijaga CHECK).
  status           StatusPersetujuan  @default(DIAJUKAN)
  alasanTolak      String?            @map("alasan_tolak")
  /// Kosong untuk versi hasil migrasi yang pengajunya tidak tercatat.
  diajukanOlehId   Int?               @map("diajukan_oleh")
  diajukanPada     DateTime           @default(now()) @map("diajukan_pada")
  diputuskanOlehId Int?               @map("diputuskan_oleh")
  diputuskanPada   DateTime?          @map("diputuskan_pada")

  karyawan       Karyawan           @relation(fields: [karyawanKode], references: [kode])
  jabatan        Jabatan            @relation(fields: [jabatanKode], references: [kode])
  golongan       Golongan           @relation(fields: [golonganKode], references: [kode])
  periodeBerlaku Periode            @relation(fields: [berlakuMulai], references: [id])
  diajukanOleh   Pengguna?          @relation("SettingDiajukan", fields: [diajukanOlehId], references: [id])
  diputuskanOleh Pengguna?          @relation("SettingDiputuskan", fields: [diputuskanOlehId], references: [id])
  tunjangan      SettingTunjangan[]
  slipGaji       SlipGaji[]

  @@index([karyawanKode, status, berlakuMulai])
  @@index([status])
  @@map("setting_gaji")
}

/// Satu versi nominal satu item master (riwayat, tidak pernah ditimpa): gaji pokok golongan, nominal tunjangan, tunjangan
/// jabatan dan tunjangan istri/anak jabatan inhouse, atau tarif jabatan event. Setiap versi diajukan HRD atau Owner (tarif
/// event hanya Owner) dengan bulan berlaku, lalu disetujui atau ditolak Owner. Nominal berlaku di periode P = versi
/// DISETUJUI dengan berlaku_mulai <= P yang paling akhir (sama dengan pemilih versi setting gaji). Tepat satu dari
/// id_golongan, id_tunjangan, id_jabatan terisi sesuai jenis (dijaga CHECK).
model VersiNominal {
  kode             String            @id @map("id_versi")
  jenis            JenisNominal
  golonganKode     String?           @map("id_golongan")
  tunjanganKode    String?           @map("id_tunjangan")
  jabatanKode      String?           @map("id_jabatan")
  /// GOLONGAN: gaji pokok per bulan. TUNJANGAN: nominal per bulan. JABATAN_EVENT: tarif per satuan jabatan. JABATAN: 0.
  nominal          Int               @default(0)
  /// Hanya JABATAN (inhouse): tunjangan jabatan dan tunjangan istri/anak (dibayar bila PTKP K/*). Jenis lain 0.
  tunjJabatan      Int               @default(0) @map("tunj_jabatan")
  tunjKeluarga     Int               @default(0) @map("tunj_keluarga")
  /// Periode "YYYY-MM" mulai berlakunya versi ini.
  berlakuMulai     String            @map("berlaku_mulai")
  alasan           String            @default("")
  /// DIAJUKAN, DISETUJUI, atau DITOLAK (DRAFT tidak dipakai, dijaga CHECK).
  status           StatusPersetujuan @default(DIAJUKAN)
  alasanTolak      String?           @map("alasan_tolak")
  /// Kosong untuk versi hasil migrasi yang pengajunya tidak tercatat.
  diajukanOlehId   Int?              @map("diajukan_oleh")
  diajukanPada     DateTime          @default(now()) @map("diajukan_pada")
  diputuskanOlehId Int?              @map("diputuskan_oleh")
  diputuskanPada   DateTime?         @map("diputuskan_pada")

  golongan       Golongan?       @relation(fields: [golonganKode], references: [kode], onDelete: Restrict)
  tunjangan      Tunjangan?      @relation(fields: [tunjanganKode], references: [kode], onDelete: Restrict)
  jabatan        Jabatan?        @relation(fields: [jabatanKode], references: [kode], onDelete: Restrict)
  periodeBerlaku Periode         @relation(fields: [berlakuMulai], references: [id])
  diajukanOleh   Pengguna?       @relation("NominalDiajukan", fields: [diajukanOlehId], references: [id])
  diputuskanOleh Pengguna?       @relation("NominalDiputuskan", fields: [diputuskanOlehId], references: [id])
  slipGajiPokok  SlipGaji[]      @relation("SlipVersiGajiPokok")
  slipJabatan    SlipGaji[]      @relation("SlipVersiJabatan")
  slipTunjangan  SlipTunjangan[]
  slipFee        SlipFee[]

  @@index([jenis, status, berlakuMulai])
  @@index([golonganKode])
  @@index([tunjanganKode])
  @@index([jabatanKode])
  @@index([status])
  @@map("versi_nominal")
}

model SettingTunjangan {
  settingKode   String @map("id_setting")
  tunjanganKode String @map("id_tunjangan")

  setting   SettingGaji @relation(fields: [settingKode], references: [kode], onDelete: Cascade)
  tunjangan Tunjangan   @relation(fields: [tunjanganKode], references: [kode])

  @@id([settingKode, tunjanganKode])
  @@map("setting_tunjangan")
}

model Presensi {
  id           Int      @id @default(autoincrement()) @map("id_presensi")
  karyawanKode String   @map("id_karyawan")
  tanggal      DateTime @db.Date
  /// Jabatan (dan jadwal kerjanya) yang dipakai menghitung terlambat saat presensi dicatat.
  jabatanKode  String   @map("id_jabatan")
  absensi      Absensi
  jamMasuk     String?  @map("jam_masuk")
  jamKeluar    String?  @map("jam_keluar")
  /// Menit terlambat dibanding jam masuk jadwal.
  terlambat    Int      @default(0)
  dibuatOlehId Int      @map("dibuat_oleh")
  dibuatPada   DateTime @default(now()) @map("dibuat_pada")

  karyawan   Karyawan @relation(fields: [karyawanKode], references: [kode])
  jabatan    Jabatan  @relation(fields: [jabatanKode], references: [kode])
  dibuatOleh Pengguna @relation(fields: [dibuatOlehId], references: [id])

  @@unique([karyawanKode, tanggal])
  @@index([tanggal])
  @@index([jabatanKode])
  @@map("presensi")
}

/// Slip gaji satu karyawan untuk satu periode. Status DISETUJUI ditampilkan sebagai "Dibayar".
model SlipGaji {
  no                 String            @id @map("id_slip")
  periodeId          String            @map("periode")
  karyawanKode       String            @map("id_karyawan")
  jabatanKode        String            @map("id_jabatan")
  golonganKode       String            @map("id_golongan")
  akunBebanKode      String            @map("akun_beban")
  statusPtkp         StatusPtkp        @map("status_ptkp")
  hariKerja          Int               @map("hari_kerja")
  jumlahPresensi     Int               @map("jumlah_presensi")
  hadir              Int
  izin               Int
  sakit              Int
  cuti               Int
  alpa               Int
  jamKerja           Float             @map("jam_kerja")
  terlambatMenit     Int               @map("terlambat_menit")
  gajiPokok          Int               @map("gaji_pokok")
  tunjJabatan        Int               @map("tunj_jabatan")
  tunjKeluarga       Int               @map("tunj_keluarga")
  /// Jumlah tunjangan lain; rinciannya di SlipTunjangan.
  tunjLain           Int               @map("tunj_lain")
  potonganAbsen      Int               @map("potongan_absen")
  bruto              Int
  brutoSetahun       Int               @map("bruto_setahun")
  biayaJabatan       Int               @map("biaya_jabatan")
  netoSetahun        Int               @map("neto_setahun")
  ptkp               Int
  pkp                Int
  pphSetahun         Int               @map("pph_setahun")
  pph21              Int
  thp                Int
  status             StatusPersetujuan @default(DRAFT)
  alasanTolak        String?           @map("alasan_tolak")
  penggajianNo       String?           @map("no_penggajian")
  /// Versi setting gaji yang dipakai saat slip dihitung. Slip draf dengan versi lain dari versi berlaku = perlu dihitung ulang.
  settingKode        String?           @map("id_setting")
  /// Versi nominal gaji pokok (golongan) dan nominal jabatan (tunjangan jabatan, tunjangan istri/anak) yang dipakai saat
  /// slip dihitung. Kosong = slip lama yang nilainya tidak cocok dengan versi awal hasil migrasi.
  versiGajiPokokKode String?           @map("id_versi_gaji_pokok")
  versiJabatanKode   String?           @map("id_versi_jabatan")
  dibuatOlehId       Int               @map("dibuat_oleh")
  dihitungPada       DateTime          @default(now()) @map("dihitung_pada")
  disetujuiOlehId    Int?              @map("disetujui_oleh")
  disetujuiPada      DateTime?         @map("disetujui_pada")

  periode        Periode         @relation(fields: [periodeId], references: [id])
  karyawan       Karyawan        @relation(fields: [karyawanKode], references: [kode])
  jabatan        Jabatan         @relation(fields: [jabatanKode], references: [kode])
  golongan       Golongan        @relation(fields: [golonganKode], references: [kode])
  akunBeban      Akun            @relation(fields: [akunBebanKode], references: [kode])
  penggajian     Penggajian?     @relation(fields: [penggajianNo], references: [no])
  setting        SettingGaji?    @relation(fields: [settingKode], references: [kode])
  versiGajiPokok VersiNominal?   @relation("SlipVersiGajiPokok", fields: [versiGajiPokokKode], references: [kode])
  versiJabatan   VersiNominal?   @relation("SlipVersiJabatan", fields: [versiJabatanKode], references: [kode])
  dibuatOleh     Pengguna        @relation("SlipDibuat", fields: [dibuatOlehId], references: [id])
  disetujuiOleh  Pengguna?       @relation("SlipDisetujui", fields: [disetujuiOlehId], references: [id])
  tunjangan      SlipTunjangan[]

  @@unique([periodeId, karyawanKode])
  @@index([penggajianNo])
  @@map("slip_gaji")
}

/// Rincian tunjangan lain di slip (salinan nama dan nominal saat dihitung, beserta versi nominal yang dipakai).
model SlipTunjangan {
  slipNo        String  @map("id_slip")
  tunjanganKode String  @map("id_tunjangan")
  nama          String
  nominal       Int
  /// Kosong = slip lama yang nominalnya tidak cocok dengan versi awal hasil migrasi.
  versiKode     String? @map("id_versi")

  slip      SlipGaji      @relation(fields: [slipNo], references: [no], onDelete: Cascade)
  tunjangan Tunjangan     @relation(fields: [tunjanganKode], references: [kode])
  versi     VersiNominal? @relation(fields: [versiKode], references: [kode])

  @@id([slipNo, tunjanganKode])
  @@map("slip_tunjangan")
}

/// Pengajuan distribusi gaji satu periode (1:1..N slip gaji).
model Penggajian {
  no              String            @id @map("no_penggajian")
  periodeId       String            @map("periode")
  jumlahSlip      Int               @map("jumlah_slip")
  totalBruto      Int               @map("total_bruto")
  totalPph        Int               @map("total_pph")
  totalThp        Int               @map("total_thp")
  status          StatusPersetujuan @default(DIAJUKAN)
  alasanTolak     String?           @map("alasan_tolak")
  jurnalNo        String?           @unique @map("jurnal_no")
  dibuatOlehId    Int               @map("dibuat_oleh")
  dibuatPada      DateTime          @default(now()) @map("dibuat_pada")
  disetujuiOlehId Int?              @map("disetujui_oleh")
  disetujuiPada   DateTime?         @map("disetujui_pada")

  periode       Periode    @relation(fields: [periodeId], references: [id])
  jurnal        Jurnal?    @relation(fields: [jurnalNo], references: [no])
  dibuatOleh    Pengguna   @relation("PenggajianDibuat", fields: [dibuatOlehId], references: [id])
  disetujuiOleh Pengguna?  @relation("PenggajianDisetujui", fields: [disetujuiOlehId], references: [id])
  slip          SlipGaji[]

  @@index([periodeId, status])
  @@map("penggajian")
}

// ======================================================================
// Fee event (crew freelance per event)
// ======================================================================

/// Event (acara) yang dikerjakan crew freelance. Kode EVT-2026-0001.
model Event {
  kode           String      @id @map("id_event")
  nama           String
  klien          String      @default("")
  tanggalMulai   DateTime    @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime    @map("tanggal_selesai") @db.Date
  status         StatusEvent @default(PENILAIAN)
  /// Alasan penolakan laporan terakhir oleh Owner (ditampilkan ke kapten sampai laporan dikirim ulang).
  alasanTolak    String?     @map("alasan_tolak")
  dibuatOlehId   Int         @map("dibuat_oleh")
  dibuatPada     DateTime    @default(now()) @map("dibuat_pada")

  dibuatOleh Pengguna         @relation("EventDibuat", fields: [dibuatOlehId], references: [id])
  sesi       SesiEvent[]
  penugasan  PenugasanEvent[]
  laporan    LaporanFee[]
  slipFee    SlipFee[]

  @@index([status])
  @@map("event")
}

/// Sub-event / sesi kerja (Meeting, Loading in, Hari H, Loading out). Jam "HH:MM", selesai sesudah mulai di hari yang sama.
model SesiEvent {
  id         Int      @id @default(autoincrement()) @map("id_sesi")
  eventKode  String   @map("id_event")
  nama       String
  tanggal    DateTime @db.Date
  jamMulai   String   @map("jam_mulai")
  jamSelesai String   @map("jam_selesai")

  event     Event            @relation(fields: [eventKode], references: [kode], onDelete: Cascade)
  kehadiran KehadiranEvent[]

  @@index([eventKode, tanggal])
  @@map("sesi_event")
}

/// Penugasan karyawan EVENT ke satu event dengan jabatan EVENT (Kapten atau Crew). Satu orang satu penugasan per event.
model PenugasanEvent {
  id           Int    @id @default(autoincrement()) @map("id_penugasan")
  eventKode    String @map("id_event")
  karyawanKode String @map("id_karyawan")
  jabatanKode  String @map("id_jabatan")

  event    Event    @relation(fields: [eventKode], references: [kode], onDelete: Cascade)
  karyawan Karyawan @relation(fields: [karyawanKode], references: [kode])
  jabatan  Jabatan  @relation(fields: [jabatanKode], references: [kode])

  @@unique([eventKode, karyawanKode])
  @@map("penugasan_event")
}

/// Kehadiran satu orang di satu sesi (dicatat HRD) beserta penilaian progresnya (kapten untuk crew, Owner untuk kapten).
model KehadiranEvent {
  id             Int             @id @default(autoincrement()) @map("id_kehadiran")
  sesiId         Int             @map("id_sesi")
  karyawanKode   String          @map("id_karyawan")
  jamMasuk       String          @map("jam_masuk")
  jamPulang      String          @map("jam_pulang")
  catatanProgres String          @default("") @map("catatan_progres")
  penilaian      HasilPenilaian?
  /// Diisi bila KURANG: menit yang diakui (tidak boleh melebihi menit tercatat yang dipotong ke jadwal sesi).
  menitDiakui    Int?            @map("menit_diakui")
  catatanNilai   String?         @map("catatan_nilai")
  dinilaiOlehId  Int?            @map("dinilai_oleh")
  dinilaiPada    DateTime?       @map("dinilai_pada")
  dibuatOlehId   Int             @map("dibuat_oleh")
  dibuatPada     DateTime        @default(now()) @map("dibuat_pada")

  sesi        SesiEvent @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  karyawan    Karyawan  @relation(fields: [karyawanKode], references: [kode])
  dinilaiOleh Pengguna? @relation("KehadiranDinilai", fields: [dinilaiOlehId], references: [id])
  dibuatOleh  Pengguna  @relation("KehadiranDibuat", fields: [dibuatOlehId], references: [id])

  @@unique([sesiId, karyawanKode])
  @@map("kehadiran_event")
}

/// Laporan progres yang dikirim kapten ke Owner. Satu event bisa punya beberapa laporan (yang ditolak tetap tersimpan sebagai jejak).
model LaporanFee {
  no               String            @id @map("no_laporan")
  eventKode        String            @map("id_event")
  status           StatusPersetujuan @default(DIAJUKAN)
  catatanKapten    String            @default("") @map("catatan_kapten")
  /// Salinan total usulan saat laporan dikirim.
  totalUsulan      Int               @map("total_usulan")
  totalFee         Int?              @map("total_fee")
  totalPph         Int?              @map("total_pph")
  totalDibayar     Int?              @map("total_dibayar")
  alasanTolak      String?           @map("alasan_tolak")
  jurnalNo         String?           @unique @map("jurnal_no")
  diajukanOlehId   Int               @map("diajukan_oleh")
  diajukanPada     DateTime          @default(now()) @map("diajukan_pada")
  diputuskanOlehId Int?              @map("diputuskan_oleh")
  diputuskanPada   DateTime?         @map("diputuskan_pada")

  event          Event     @relation(fields: [eventKode], references: [kode])
  jurnal         Jurnal?   @relation(fields: [jurnalNo], references: [no])
  diajukanOleh   Pengguna  @relation("LaporanDiajukan", fields: [diajukanOlehId], references: [id])
  diputuskanOleh Pengguna? @relation("LaporanDiputuskan", fields: [diputuskanOlehId], references: [id])
  slip           SlipFee[]

  @@index([eventKode, status])
  @@map("laporan_fee")
}

/// Slip fee satu orang untuk satu event, dibuat saat Owner menyetujui laporan (status selalu "Dibayar").
model SlipFee {
  no             String      @id @map("id_slip_fee")
  laporanNo      String      @map("no_laporan")
  eventKode      String      @map("id_event")
  karyawanKode   String      @map("id_karyawan")
  jabatanKode    String      @map("id_jabatan")
  akunBebanKode  String      @map("akun_beban")
  peranEvent     PeranEvent  @map("peran_event")
  satuanTarif    SatuanTarif @map("satuan_tarif")
  tarif          Int
  /// Versi tarif jabatan event yang dipakai (berlaku di bulan tanggal selesai event). Kosong = slip lama yang tarifnya
  /// tidak cocok dengan versi awal hasil migrasi.
  versiTarifKode String?     @map("id_versi_tarif")
  jumlahSesi     Int         @map("jumlah_sesi")
  menitTercatat  Int         @map("menit_tercatat")
  menitDiakui    Int         @map("menit_diakui")
  jumlahHari     Int         @map("jumlah_hari")
  feeUsulan      Int         @map("fee_usulan")
  /// Fee akhir dari Owner = bruto.
  feeAkhir       Int         @map("fee_akhir")
  alasanUbah     String?     @map("alasan_ubah")
  dpp            Int
  pph21          Int
  dibayar        Int
  /// Karyawan inhouse: upah event dibayar lewat Gaji Bulanan periode ini (tanpa PPh bukan pegawai dan tanpa jurnal fee).
  /// Kosong = crew freelance yang dibayar lewat slip fee dan jurnal fee event.
  periodeGajiId  String?     @map("periode_gaji")

  laporan     LaporanFee    @relation(fields: [laporanNo], references: [no])
  event       Event         @relation(fields: [eventKode], references: [kode])
  karyawan    Karyawan      @relation(fields: [karyawanKode], references: [kode])
  jabatan     Jabatan       @relation(fields: [jabatanKode], references: [kode])
  akunBeban   Akun          @relation(fields: [akunBebanKode], references: [kode])
  versiTarif  VersiNominal? @relation(fields: [versiTarifKode], references: [kode])
  periodeGaji Periode?      @relation(fields: [periodeGajiId], references: [id])

  @@unique([eventKode, karyawanKode])
  @@index([laporanNo])
  @@index([periodeGajiId, karyawanKode])
  @@map("slip_fee")
}
